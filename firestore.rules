            && data.ciphertext is string && data.ciphertext.size() >= 24 && data.ciphertext.size() <= 256
            && data.ciphertext.matches('^[A-Za-z0-9+/]+={0,2}$')
            && data.iv is string && data.iv.matches('^[A-Za-z0-9+/]{16}$')
            && data.createdBy == request.auth.uid && data.createdAt == request.time;
        }
        allow read: if activeMember(orgId);
        allow create: if activeAdmin(orgId) && validHistory(request.resource.data)
          && get(/databases/$(database)/documents/organizations/$(orgId)/keyMetadata/current).data.currentKeyVersion == request.resource.data.keyVersion
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/keyMetadata/current).data.currentKeyVersion == request.resource.data.wrappingVersion;
        allow update, delete: if false;
      }

      match /keyEnvelopes/{userId} {
        allow get: if activeMember(orgId)
          && (request.auth.uid == userId || activeAdmin(orgId));
        allow list: if activeAdmin(orgId);
        allow create: if activeAdmin(orgId) && !maintenanceActive(orgId) && !maintenanceAfter(orgId)
          && activeKeyRecipient(orgId, userId)
          && validKeyEnvelope(request.resource.data, userId)
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/keyMetadata/current).data.currentKeyVersion
            == request.resource.data.keyVersion;
        allow update: if activeAdmin(orgId) && !maintenanceActive(orgId) && !maintenanceAfter(orgId)
          && activeKeyRecipient(orgId, userId)
          && validKeyEnvelope(request.resource.data, userId)
          && request.resource.data.createdAt == request.time
          && (request.resource.data.keyVersion > resource.data.keyVersion || approvingKeyReplacement(orgId, userId))
          && request.resource.data.userId == resource.data.userId
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/keyMetadata/current).data.currentKeyVersion
            == request.resource.data.keyVersion;
        allow delete: if false;
      }

      // Active admins, doctors, and nurses can use clinical rosters. Ward setup
      // and configuration are admin-only; woman admissions are created by clinicians.
      match /wards/{wardId} {
        function validRosterEnvelope(data) {
          return data.keys().hasOnly(['ciphertext', 'iv', 'keyVersion', 'algorithm', 'schemaVersion', 'createdBy', 'createdAt'])
            && data.keys().hasAll(['ciphertext', 'iv', 'keyVersion', 'algorithm', 'schemaVersion', 'createdBy', 'createdAt'])
            && data.ciphertext is string && data.ciphertext.size() > 0 && data.ciphertext.size() <= 16384
            && data.ciphertext.matches('^[A-Za-z0-9+/]+={0,2}$')
            && data.iv is string && data.iv.matches('^[A-Za-z0-9+/]{16}$')
            && currentDataKey(orgId, data.keyVersion) && data.algorithm == 'AES-GCM' && data.schemaVersion == 1
            && data.createdBy == request.auth.uid && data.createdAt is timestamp;
        }
        allow get, list: if activeClinicalMember(orgId);
        allow create: if activeAdmin(orgId) && validRosterEnvelope(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if activeAdmin(orgId) && validRosterEnvelope(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ciphertext', 'iv', 'keyVersion', 'algorithm', 'schemaVersion', 'createdBy', 'createdAt'
          ]);
        allow delete: if false;
      }
      match /women/{womanId} {
        function validRosterEnvelope(data) {
          return data.keys().hasOnly(['ciphertext', 'iv', 'keyVersion', 'algorithm', 'schemaVersion', 'createdBy', 'createdAt', 'archived', 'archiveRevision', 'lastArchiveEventId'])
            && data.keys().hasAll(['ciphertext', 'iv', 'keyVersion', 'algorithm', 'schemaVersion', 'createdBy', 'createdAt'])
            && data.ciphertext is string && data.ciphertext.size() > 0 && data.ciphertext.size() <= 16384
            && data.ciphertext.matches('^[A-Za-z0-9+/]+={0,2}$')
            && data.iv is string && data.iv.matches('^[A-Za-z0-9+/]{16}$')
            // Archive updates preserve the immutable envelope, which can use a historical key.
            && data.keyVersion is int && data.keyVersion >= 1 && data.keyVersion <= 1000000
            && data.keyVersion <= get(/databases/$(database)/documents/organizations/$(orgId)/keyMetadata/current).data.currentKeyVersion
            && data.algorithm == 'AES-GCM' && data.schemaVersion == 1
            && data.createdBy is string && data.createdAt is timestamp;
        }
        function validArchiveTransition(data) {
          let event = getAfter(/databases/$(database)/documents/organizations/$(orgId)/rosterArchiveEvents/$(data.lastArchiveEventId)).data;
          return validRosterEnvelope(data)
            && data.archived is bool && data.archived != resource.data.get('archived', false)
            && data.archiveRevision is int && data.archiveRevision == resource.data.get('archiveRevision', 0) + 1
            && data.archiveRevision <= 2147483647
            && data.lastArchiveEventId is string && data.lastArchiveEventId.matches('^[A-Za-z0-9_-]{1,128}$')
            && data.diff(resource.data).affectedKeys().hasOnly(['archived', 'archiveRevision', 'lastArchiveEventId'])
            && !exists(/databases/$(database)/documents/organizations/$(orgId)/rosterArchiveEvents/$(data.lastArchiveEventId))
            && event.womanDocumentId == womanId && event.archived == data.archived
            && event.revision == data.archiveRevision && event.createdBy == request.auth.uid
            && event.createdAt == request.time;
        }
        allow get, list: if activeClinicalMember(orgId);
        allow create: if writableClinicalMember(orgId) && validRosterEnvelope(request.resource.data)
          && currentDataKey(orgId, request.resource.data.keyVersion)
          && request.resource.data.keys().hasOnly(['ciphertext', 'iv', 'keyVersion', 'algorithm', 'schemaVersion', 'createdBy', 'createdAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if canManageWomanArchive(orgId) && validArchiveTransition(request.resource.data);
        allow delete: if false;
      }

      // Archive status and immutable audit event must be committed together. Names remain encrypted.
      match /rosterArchiveEvents/{eventId} {
        function validArchiveEvent(data) {
          let before = get(/databases/$(database)/documents/organizations/$(orgId)/women/$(data.womanDocumentId)).data;
          let after = getAfter(/databases/$(database)/documents/organizations/$(orgId)/women/$(data.womanDocumentId)).data;
          return data.keys().hasOnly(['womanDocumentId', 'archived', 'revision', 'createdBy', 'accessLevel', 'createdAt',
              'ciphertext', 'iv', 'keyVersion', 'algorithm', 'schemaVersion'])
            && data.keys().hasAll(['womanDocumentId', 'archived', 'revision', 'createdBy', 'accessLevel', 'createdAt',
              'ciphertext', 'iv', 'keyVersion', 'algorithm', 'schemaVersion'])
            && data.womanDocumentId is string && data.womanDocumentId.matches('^[A-Za-z0-9_-]{1,128}$')
            && data.archived is bool && data.archived != before.get('archived', false)
            && data.revision is int && data.revision == before.get('archiveRevision', 0) + 1
            && data.revision <= 2147483647
            && after.archived == data.archived && after.archiveRevision == data.revision && after.lastArchiveEventId == eventId
            && data.createdBy == request.auth.uid
            && data.accessLevel == get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.accessLevel
            && data.createdAt == request.time
            && data.ciphertext is string && data.ciphertext.size() >= 24 && data.ciphertext.size() <= 4096
            && data.ciphertext.matches('^[A-Za-z0-9+/]+={0,2}$')
            && data.iv is string && data.iv.matches('^[A-Za-z0-9+/]{16}$')
            && currentDataKey(orgId, data.keyVersion) && data.algorithm == 'AES-GCM' && data.schemaVersion == 2;
        }
        allow get, list: if activeClinicalMember(orgId);
        allow create: if canManageWomanArchive(orgId) && validArchiveEvent(request.resource.data);
        allow update, delete: if false;
      }

      // Isolated fake-data sync demonstrator for already-approved clinical staff.
      // The client manually shares a synthetic key; do not use this as key delivery.
      match /clinicalData/{dataVersion}/observations/{observationId} {
        allow get, list: if dataVersion == 'v1'
          && observationId == 'latest'
          && activeClinicalMember(orgId);
        allow create: if dataVersion == 'v1'
          && observationId == 'latest'
          && writableClinicalMember(orgId)
          && validSyntheticObservation(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if dataVersion == 'v1'
          && observationId == 'latest'
          && writableClinicalMember(orgId)
          && resource.data.createdBy == request.auth.uid
          && validSyntheticObservation(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow delete: if false;
      }

      // Synthetic Labour Care Guide demo only. Documents contain an AES-GCM envelope;
      // the complete observation (including its synthetic label) is client-encrypted.
      match /clinicalData/{dataVersion}/chartStarts/{womanId} {
        function validChartStart(data) {
          return data.keys().hasOnly(['startMillis', 'womanDocumentId', 'sessionId'])
            && data.keys().hasAll(['startMillis', 'womanDocumentId', 'sessionId'])
            && data.startMillis is number && data.startMillis >= 0 && data.startMillis <= request.time.toMillis()
            && womanId.matches('^[A-Za-z0-9_-]{1,128}$') && data.womanDocumentId == womanId
            && data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() <= 256
            && get(/databases/$(database)/documents/organizations/$(orgId)/women/$(womanId)).data.get('archived', false) == false;
        }
        allow read: if dataVersion == 'v1' && activeClinicalMember(orgId);
        allow create: if dataVersion == 'v1' && writableClinicalMember(orgId) && validChartStart(request.resource.data);
        allow update: if dataVersion == 'v1' && writableClinicalMember(orgId) && validChartStart(request.resource.data)
          && request.resource.data == resource.data;
      }
      match /clinicalData/{dataVersion}/lcgObservations/{observationId} {
        function validEnvelope(data) {
          return data.ciphertext is string
            && data.ciphertext.size() > 0
            && data.ciphertext.size() <= 16384
            && data.ciphertext.matches('^[A-Za-z0-9+/]+={0,2}$')
            && data.iv is string
            && data.iv.matches('^[A-Za-z0-9+/]{16}$')
            && currentDataKey(orgId, data.keyVersion)
            && data.algorithm == 'AES-GCM'
            && data.schemaVersion == 2
            && data.createdBy == request.auth.uid
            && validAccessLevel(data.accessLevel)
            && data.createdAt is timestamp;
        }

        function validCellKey(key) {
          return key is string && key.matches('^[A-Za-z][A-Za-z0-9]{0,39}$')
            && key != 'initials' && key != 'partographMark'
            && (!key.matches('.*Half1$') || key in ['fetalHeartRateHalf1', 'fhrDecelerationHalf1', 'contractionFrequencyHalf1', 'contractionDurationHalf1', 'oxytocinHalf1']);
        }

        function validCellKeys(data) {
          let keys = data.cellKeys;
          return keys is list && keys.size() >= 1 && keys.size() <= 4
            && keys.toSet().size() == keys.size()
            && validCellKey(keys[0])
            && (keys.size() < 2 || validCellKey(keys[1]))
            && (keys.size() < 3 || validCellKey(keys[2]))
            && (keys.size() < 4 || validCellKey(keys[3]))
            && (data.cellKey == 'partographMark' || keys == [data.cellKey]);
        }

        function validCellEvent(data) {
          return data.keys().hasOnly([
              'ciphertext', 'iv', 'keyVersion', 'algorithm', 'schemaVersion', 'createdBy', 'createdAt',
              'accessLevel', 'recordType', 'womanDocumentId', 'columnId', 'cellKey', 'cellKeys', 'revision', 'reasonCiphertext', 'reasonIv', 'correctedRevision', 'observationTimeMillis', 'chartStartMillis', 'chartColumnIndex'
            ])
            && data.keys().hasAll([
              'ciphertext', 'iv', 'keyVersion', 'algorithm', 'schemaVersion', 'createdBy', 'createdAt',
              'accessLevel', 'recordType', 'womanDocumentId', 'columnId', 'cellKey', 'cellKeys', 'revision', 'observationTimeMillis'
            ])
            && validEnvelope(data)
            && data.observationTimeMillis is number && data.observationTimeMillis >= 0 && data.observationTimeMillis <= request.time.toMillis()
            && (data.recordType == 'cell'
              ? !data.keys().hasAny(['reasonCiphertext', 'reasonIv', 'correctedRevision'])
              : data.recordType == 'cellCorrection' && validCellCorrectionReason(data))
            && data.columnId is string && data.columnId.size() > 0 && data.columnId.size() <= 256
            && data.cellKey is string && data.cellKey.matches('^[A-Za-z][A-Za-z0-9]{0,39}$')
            && data.cellKey != 'initials'
            && validCellKeys(data)
            && data.revision is int && data.revision > 0 && data.revision <= 2147483647;
        }

        function validCellCorrectionReason(data) {
          return data.keys().hasAll(['reasonCiphertext', 'reasonIv', 'correctedRevision'])
            && data.reasonCiphertext is string && data.reasonCiphertext.size() >= 24
            && data.reasonCiphertext.size() <= 8192
            && data.reasonCiphertext.matches('^[A-Za-z0-9+/]+={0,2}$')
            && data.reasonIv is string && data.reasonIv.matches('^[A-Za-z0-9+/]{16}$')
            && data.correctedRevision is int && data.correctedRevision > 0;
        }

        function validConfirmationEvent(data) {
          return data.keys().hasOnly([
              'ciphertext', 'iv', 'keyVersion', 'algorithm', 'schemaVersion', 'createdBy', 'createdAt',
              'accessLevel', 'recordType', 'womanDocumentId', 'columnId', 'cellKey', 'cellKeys', 'revision'
            ])
            && data.keys().hasAll([
              'ciphertext', 'iv', 'keyVersion', 'algorithm', 'schemaVersion', 'createdBy', 'createdAt',
              'accessLevel', 'recordType', 'womanDocumentId', 'columnId', 'cellKey', 'cellKeys', 'revision'
            ])
            && validEnvelope(data)
            && data.recordType == 'confirmation'
            && data.columnId is string && data.columnId.size() > 0 && data.columnId.size() <= 256
            && data.cellKey == 'initials'
            && data.cellKeys is list && data.cellKeys.size() >= 1 && data.cellKeys.size() <= 3
            && data.cellKeys.hasAll(['initials']) && data.cellKeys.hasOnly(['initials', 'fullDilationConfirmed', 'birthConfirmed'])
            && data.cellKeys.toSet().size() == data.cellKeys.size()
            && data.revision is int && data.revision > 0 && data.revision <= 2147483647;
        }

        function scheduledEventMatches(data, column) {
          let chart = getAfter(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/chartStarts/$(column.womanDocumentId)).data;
          let secondHalf = data.cellKeys.hasAny(['fetalHeartRateHalf2', 'fhrDecelerationHalf2', 'contractionFrequencyHalf2', 'contractionDurationHalf2', 'oxytocinHalf2', 'amnioticFluidHalf2', 'mouldingHalf2', 'cervicalDilationHalf2', 'descentHalf2', 'pulseHalf2', 'systolicHalf2', 'diastolicHalf2', 'temperatureHalf2']);
          return data.chartStartMillis == chart.startMillis && data.chartColumnIndex is int && data.chartColumnIndex >= 0 && data.chartColumnIndex <= 2147483647
            && data.observationTimeMillis == chart.startMillis + data.chartColumnIndex * 3600000 + (secondHalf ? 1800000 : 0);
        }
        function cellEventMatchesColumn(data) {
          let column = getAfter(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgColumns/$(data.columnId)).data;
          let member = get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data;
          return existsAfter(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgColumns/$(data.columnId))
            && (!exists(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgColumns/$(data.columnId))
              || get(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgColumns/$(data.columnId)).data.revision < column.revision)
            && (data.recordType != 'cellCorrection' || column.confirmed)
            && (!data.keys().hasAny(['chartStartMillis', 'chartColumnIndex']) || scheduledEventMatches(data, column))
            && data.womanDocumentId == column.womanDocumentId
            && column.lastEventId == observationId
            && column.revision == data.revision
            && column.lastEditorUid == request.auth.uid
            && column.lastEditorAccessLevel == member.accessLevel
            && data.accessLevel == member.accessLevel;
        }

        function confirmationMatchesColumn(data) {
          let column = getAfter(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgColumns/$(data.columnId)).data;
          return existsAfter(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgColumns/$(data.columnId))
            && get(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgColumns/$(data.columnId)).data.revision < column.revision
            && data.womanDocumentId == column.womanDocumentId
            && column.confirmed
            && column.confirmationEventId == observationId
            && column.confirmedBy == request.auth.uid
            && column.revision == data.revision
            && data.accessLevel == get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.accessLevel;
        }

        function projectionMatches(data, key) {
          let projection = getAfter(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgCells/$(data.columnId + '~' + key)).data;
          // The projection's own validator checks equality with this immutable event.
          return projection.sourceEventId == observationId && projection.cellKey == key;
        }
        function allProjectionsMatch(data) {
          return projectionMatches(data, data.cellKeys[0])
            && (data.cellKeys.size() < 2 || projectionMatches(data, data.cellKeys[1]))
            && (data.cellKeys.size() < 3 || projectionMatches(data, data.cellKeys[2]))
            && (data.cellKeys.size() < 4 || projectionMatches(data, data.cellKeys[3]));
        }

        allow get, list: if dataVersion == 'v1' && activeClinicalMember(orgId);
        allow create: if dataVersion == 'v1'
          && allProjectionsMatch(request.resource.data)
          && writableClinicalMember(orgId)
          && request.resource.data.createdAt == request.time
          && ((validCellEvent(request.resource.data) && cellEventMatchesColumn(request.resource.data))
              || (validConfirmationEvent(request.resource.data) && confirmationMatchesColumn(request.resource.data)));
        allow update, delete: if false;
      }

      // Column state contains authorization metadata only, never patient content.
      // Cell and confirmation events are atomically appended in lcgObservations.
      match /clinicalData/{dataVersion}/lcgCells/{projectionId} {
        function validProjection(data) {
          let event = getAfter(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgObservations/$(data.sourceEventId)).data;
          return data.keys().hasOnly(['sourceEventId', 'columnId', 'womanDocumentId', 'cellKey', 'event'])
            && data.keys().hasAll(['sourceEventId', 'columnId', 'womanDocumentId', 'cellKey', 'event'])
            && data.sourceEventId is string && data.sourceEventId.matches('^[A-Za-z0-9_-]{1,128}$')
            && data.columnId is string && data.columnId.size() > 0 && data.columnId.size() <= 256
            && data.womanDocumentId == event.womanDocumentId
            && data.cellKey is string && data.cellKey.matches('^[A-Za-z][A-Za-z0-9]{0,39}$')
            && projectionId == data.columnId + '~' + data.cellKey
            && data.event == event && event.columnId == data.columnId && event.cellKeys.hasAny([data.cellKey])
            && event.createdBy == request.auth.uid && event.createdAt == request.time
            && !exists(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgObservations/$(data.sourceEventId));
        }
        allow read: if dataVersion == 'v1' && activeClinicalMember(orgId);
        allow create: if dataVersion == 'v1' && writableClinicalMember(orgId) && validProjection(request.resource.data);
        allow update: if dataVersion == 'v1' && writableClinicalMember(orgId) && validProjection(request.resource.data)
          && request.resource.data.columnId == resource.data.columnId
          && request.resource.data.womanDocumentId == resource.data.womanDocumentId
          && request.resource.data.cellKey == resource.data.cellKey
          && request.resource.data.event.revision > resource.data.event.revision;
        allow delete: if false;
      }

      match /clinicalData/{dataVersion}/lcgColumns/{columnId} {
        function memberAccessLevel() {
          return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.accessLevel;
        }

        function freshEventExistsAfter(eventId) {
          return eventId is string && eventId.matches('^[A-Za-z0-9_-]{1,128}$')
            && !exists(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgObservations/$(eventId))
            && existsAfter(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgObservations/$(eventId));
        }

        // Only the event's touched cells may acquire access metadata. Older
        // columns without metadata start empty. Run the trusted historical
        // migration before rollout to enforce old permissions on the server.
        // Header records stay editable; grid records retain access and confirmation locks.
        function isHeaderColumn() {
          return columnId.matches('^header-.+$');
        }

        function validCellAccess(data, previous) {
          let event = getAfter(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgObservations/$(data.lastEventId)).data;
          let keys = event.cellKeys;
          let levels = data.cellAccessLevels;
          let access = memberAccessLevel();
          return event.recordType in ['cell', 'cellCorrection']
            && (event.recordType != 'cellCorrection' || (resource.data.confirmed && event.correctedRevision == resource.data.revision))
            && event.columnId == columnId
            && event.revision == data.revision && event.createdBy == request.auth.uid
            && event.accessLevel == access && event.createdAt == request.time
            && (data.get('timestampMillis', null) == null || event.observationTimeMillis == data.timestampMillis
                + (keys.hasAny(['fetalHeartRateHalf2', 'fhrDecelerationHalf2', 'contractionFrequencyHalf2', 'contractionDurationHalf2', 'oxytocinHalf2', 'amnioticFluidHalf2', 'mouldingHalf2', 'cervicalDilationHalf2', 'descentHalf2', 'pulseHalf2', 'systolicHalf2', 'diastolicHalf2', 'temperatureHalf2']) ? 1800000 : 0))
            && levels is map && levels.size() <= 256
            && keys is list && keys.size() >= 1 && keys.size() <= 4
            && (!isHeaderColumn() || keys.hasOnly(['patientLabel', 'parity', 'labourOnset', 'activeLabourDiagnosis', 'rupturedMembranes', 'riskFactors', 'gravida', 'livingChildren', 'gestationalWeeks', 'gestationalDays', 'rupturedHours', 'deliveryMethod', 'deliveryDateTime', 'lscsIndication', 'babySex', 'babyWeightGrams', 'babyStatus', 'apgar1', 'apgar5', 'babyDetails']))
            && levels.diff(previous).affectedKeys().hasOnly(keys)
            && validCellAccessKey(keys[0], levels, previous, access)
            && (keys.size() < 2 || validCellAccessKey(keys[1], levels, previous, access))
            && (keys.size() < 3 || validCellAccessKey(keys[2], levels, previous, access))
            && (keys.size() < 4 || validCellAccessKey(keys[3], levels, previous, access));
        }

        function validCellAccessKey(key, levels, previous, access) {
          let ownLevel = previous.get(key, 0);
          let base = key.matches('.*Half1$') ? key.split('Half1')[0] : key;
          let aliasLevel = base in ['fetalHeartRate', 'fhrDeceleration', 'contractionFrequency', 'contractionDuration', 'oxytocin']
            ? previous.get(key == base ? base + 'Half1' : base, 0) : 0;
          let previousLevel = ownLevel >= aliasLevel ? ownLevel : aliasLevel;
          return key is string && key.matches('^[A-Za-z][A-Za-z0-9]{0,39}$')
            && key != 'initials' && key != 'partographMark'
            && (!key.matches('.*Half1$') || key in ['fetalHeartRateHalf1', 'fhrDecelerationHalf1', 'contractionFrequencyHalf1', 'contractionDurationHalf1', 'oxytocinHalf1'])
            && previousLevel is int
            && (isHeaderColumn() || previousLevel <= access)
            && levels[key] == access;
        }

        function validInitialColumn(data) {
          return data.keys().hasOnly([
              'lastEditorUid', 'lastEditorAccessLevel', 'highestEditorAccessLevel', 'highestEditorUids',
              'revision', 'confirmed', 'lastEditedAt', 'lastEventId', 'cellAccessLevels', 'womanDocumentId', 'sessionId', 'timestampMillis', 'chartColumnIndex', 'chartStartMillis'
            ])
            && data.keys().hasAll([
              'lastEditorUid', 'lastEditorAccessLevel', 'highestEditorAccessLevel', 'highestEditorUids',
              'revision', 'confirmed', 'lastEditedAt', 'lastEventId', 'cellAccessLevels', 'womanDocumentId', 'sessionId', 'timestampMillis', 'chartColumnIndex', 'chartStartMillis'
            ])
            && data.sessionId is string && data.sessionId.matches('^[A-Za-z0-9_-]{1,128}$')
            && (isHeaderColumn() ? columnId == 'header-' + data.sessionId
              : data.chartColumnIndex >= 0 && columnId == 'timeline-' + data.womanDocumentId + '-' + string(data.chartColumnIndex))
            && data.timestampMillis is number && data.timestampMillis >= 0 && data.timestampMillis <= request.time.toMillis()
            && data.chartColumnIndex is int && data.chartColumnIndex >= -1 && data.chartColumnIndex <= 2147483647
            && data.chartStartMillis is number && data.chartStartMillis >= 0 && data.chartStartMillis <= data.timestampMillis
            && data.lastEditorUid == request.auth.uid
            && validAccessLevel(data.lastEditorAccessLevel)
            && data.lastEditorAccessLevel == memberAccessLevel()
            && data.highestEditorAccessLevel == data.lastEditorAccessLevel
            && data.highestEditorUids == [request.auth.uid]
            && data.revision == 1
            && data.confirmed == false
            && data.lastEditedAt == request.time
            && freshEventExistsAfter(data.lastEventId)
            && validCellAccess(data, {});
        }

        function validCellEditUpdate(data) {
          let changed = data.diff(resource.data).affectedKeys();
          let access = memberAccessLevel();
          let higher = access > resource.data.highestEditorAccessLevel;
          let tied = access == resource.data.highestEditorAccessLevel;
          return resource.data.confirmed is bool
            && changed.hasOnly([
              'lastEditorUid', 'lastEditorAccessLevel', 'highestEditorAccessLevel', 'highestEditorUids',
              'revision', 'lastEditedAt', 'lastEventId', 'cellAccessLevels'
            ].concat(isHeaderColumn() ? ['confirmed'] : []))
            && (!isHeaderColumn() || data.confirmed == false)
            && validCellAccess(data, resource.data.get('cellAccessLevels', {}))
            && data.lastEditorUid == request.auth.uid
            && data.lastEditorAccessLevel == access
            && data.revision == resource.data.revision + 1
            && data.lastEditedAt == request.time
            && freshEventExistsAfter(data.lastEventId)
            && (higher
              ? data.highestEditorAccessLevel == access && data.highestEditorUids == [request.auth.uid]
              : tied
                ? data.highestEditorAccessLevel == resource.data.highestEditorAccessLevel
                  && data.highestEditorUids.hasAll(resource.data.highestEditorUids)
                  && data.highestEditorUids.hasAny([request.auth.uid])
                  && data.highestEditorUids.toSet().size() == data.highestEditorUids.size()
                  && data.highestEditorUids.toSet().difference(resource.data.highestEditorUids.toSet()).hasOnly([request.auth.uid])
                  && data.highestEditorUids.size() <= resource.data.highestEditorUids.size() + 1
                : data.highestEditorAccessLevel == resource.data.highestEditorAccessLevel
                  && data.highestEditorUids == resource.data.highestEditorUids);
        }

        // Called only for a signed column. Read the immutable prior event once.
        function higherThanSignOff(access, eventId) {
          let previous = get(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgObservations/$(eventId)).data;
          return previous.recordType == 'confirmation' && previous.cellKey == 'initials'
            && previous.columnId == columnId && previous.createdBy == resource.data.confirmedBy
            && validAccessLevel(previous.accessLevel) && access > previous.accessLevel;
        }

        function canSupersedeSignOff(access) {
          let previousId = resource.data.get('confirmationEventId', '');
          return !resource.data.confirmed || (
            previousId is string && previousId.matches('^[A-Za-z0-9_-]{1,128}$')
            && higherThanSignOff(access, previousId)
          );
        }

        // The column and its new immutable sign-off must agree in the SAME atomic commit.
        function matchingNewSignOff(data, access) {
          let eventId = data.confirmationEventId;
          let event = getAfter(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgObservations/$(eventId)).data;
          return eventId is string && eventId.matches('^[A-Za-z0-9_-]{1,128}$')
            && !exists(/databases/$(database)/documents/organizations/$(orgId)/clinicalData/v1/lcgObservations/$(eventId))
            && event.recordType == 'confirmation' && event.cellKey == 'initials'
            && event.columnId == columnId && event.revision == data.revision
            && event.createdBy == request.auth.uid && event.accessLevel == access
            && event.createdAt == request.time;
        }

        function validConfirmationUpdate(data) {
          let access = memberAccessLevel();
          return !isHeaderColumn() && resource.data.confirmed is bool
            && data.diff(resource.data).affectedKeys().hasOnly(['confirmed', 'confirmedBy', 'confirmedAt', 'confirmationEventId', 'revision'])
            && data.confirmed == true
            && validAccessLevel(access)
            && canSupersedeSignOff(access)
            && data.confirmedBy == request.auth.uid
            && data.confirmedAt == request.time
            && data.revision is int && data.revision <= 2147483647
            && data.revision == resource.data.revision + 1
            && matchingNewSignOff(data, access);
        }

        // Trusted staff can link legacy encrypted records once. All clinical fields stay unchanged.
        function validHistoricalRosterBinding(data) {
          return data.diff(resource.data).affectedKeys().hasOnly(['womanDocumentId'])
            && (resource.data.get('womanDocumentId', '') == '' || data.womanDocumentId == resource.data.womanDocumentId)
            && canManageWomanArchive(orgId)
            && validClinicalRosterLink(orgId, data);
        }

        allow get, list: if dataVersion == 'v1' && activeClinicalMember(orgId);
        allow create: if dataVersion == 'v1' && writableClinicalMember(orgId)
          && writableClinicalColumn(orgId, request.resource.data) && validInitialColumn(request.resource.data);
        allow update: if dataVersion == 'v1' && writableClinicalMember(orgId)
          && (validHistoricalRosterBinding(request.resource.data)
            || (request.resource.data.womanDocumentId == resource.data.womanDocumentId
              && writableClinicalColumn(orgId, request.resource.data)
              && (validCellEditUpdate(request.resource.data) || validConfirmationUpdate(request.resource.data))));
        allow delete: if false;
      }

      // Legacy note-only corrections remain readable; new corrections are
      // encrypted cellCorrection events atomically updating a confirmed column.
      match /clinicalData/{dataVersion}/lcgCorrections/{correctionId} {
        allow get, list: if dataVersion == 'v1' && activeClinicalMember(orgId);
        allow write: if false;
      }

      // Unmodeled organization paths remain closed by default.
      match /{organizationData=**} {
        allow read, write: if false;
      }
    }

    // Collection-group listeners used by a user are constrained to documents
    // whose userId is their own UID. Firestore Rules are not query filters, so
    // clients must include where('userId', '==', request.auth.uid).
    match /{parent=**}/members/{memberId} {
      allow get, list: if verifiedUser() && resource.data.userId == request.auth.uid;
    }
    match /{parent=**}/accessRequests/{requestId} {
      allow get, list: if verifiedUser() && resource.data.userId == request.auth.uid;
    }

    // All unmodeled collections are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
