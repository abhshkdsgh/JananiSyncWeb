      // Admin-only authenticated recipient pins. Ciphertext is encrypted under the
      // recovery-derived admin control key, never the organization-wide DEK.
      match /rotationRecipients/{userId} {
        function validRecipientPin(data) {
          return data.keys().hasOnly(['ciphertext', 'iv', 'adminId', 'schemaVersion', 'updatedAt'])
            && data.keys().hasAll(['ciphertext', 'iv', 'adminId', 'schemaVersion', 'updatedAt'])
