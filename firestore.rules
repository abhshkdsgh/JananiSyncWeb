      }

      match /keyHistory/{versionId} {
        function validHistory(data) {
          return data.keys().hasOnly(['keyVersion', 'wrappingVersion', 'ciphertext', 'iv', 'createdBy', 'createdAt'])
            && data.keys().hasAll(['keyVersion', 'wrappingVersion', 'ciphertext', 'iv', 'createdBy', 'createdAt'])
            && data.keyVersion is int && data.keyVersion >= 1 && data.keyVersion < 1000000
            && versionId == string(data.keyVersion)
