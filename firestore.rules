          && request.resource.data.updatedAt == request.time;
        allow update: if metadataId == 'current'
          && activeAdmin(orgId) && validKeyMetadata(request.resource.data)
          && maintenanceActive(orgId) && !maintenanceAfter(orgId)
          && request.resource.data.currentKeyVersion == resource.data.currentKeyVersion + 1
          && request.resource.data.rotationId == get(/databases/$(database)/documents/organizations/$(orgId)/keyMaintenance/current).data.rotationId
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/keyRotations/$(request.resource.data.rotationId)).data.phase == 'completed'
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/keyHistory/$(string(resource.data.currentKeyVersion))).data.wrappingVersion == request.resource.data.currentKeyVersion
          && get(/databases/$(database)/documents/organizations/$(orgId)/keyRotations/$(request.resource.data.rotationId)/grants/$(request.auth.uid)).data.keyVersion == request.resource.data.currentKeyVersion
          && request.resource.data.updatedAt == request.time
