rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Privacy model (independent of email verification so provisional accounts can decide):
    // users/{uid}/privacyEvents/{20-char auto ID}: immutable, owner-readable decision;
    // schemaVersion (1), presentationVersion (2), userId (1..128), token email (1..320),
    // token emailVerified (bool), policyVersion/hash (pinned below), accepted/denied,
    // source (signup/account_gate/settings), server createdAt, client clock (epoch ms),
    // language (1..64), userAgent (0..512; client-reported, not independently verified).
    // users/{uid}/privacy/current: userId, lastEventId, decision, pinned policyVersion/hash,
    // server updatedAt. Both records must be committed atomically, each pointing to
    // the other. No client can edit/delete historical events or replay an old event.
    // Additional key-storage data model implemented here:
    // organizations/{orgId}/keyReplacementRequests/{uid}: userId, requestId (opaque 22 chars),
    // previousFingerprint, profile (validated public key), backup (validated encrypted private key),
    // createdAt, status (pending/approved/rejected/cancelled); resolvedBy/resolvedAt on resolution.
    // Only active clinical members request; only active admins approve with an atomic regrant.
    // organizations/{orgId}/keyProfiles/{uid}: userId, publicKeyJwk (string <= 4096),
    //   publicKeyFingerprint (string <= 64), keyAlgorithm (fixed string), createdAt (timestamp).
    // organizations/{orgId}/keyMetadata/current: currentKeyVersion (int), algorithm
    //   (fixed string), updatedAt (timestamp), updatedBy (UID). Admin-write/member-read.
    // organizations/{orgId}/keyEnvelopes/{uid}: userId, keyVersion, wrappedKey
    //   (base64 RSA ciphertext <= 2048), algorithm, grantedBy, createdAt. Only the
    //   owner and org admins can read; only admins can create/replace envelopes.
    // organizations/{orgId}/keyBackups/{uid}: ciphertext, iv, salt, KDF metadata,
    //   algorithm, updatedAt. Contains only that org's recovery-encrypted private JWK;
    //   the member alone can read or replace it.
    // Data model: organizations/{orgId}/clinicalData/v1/lcgObservations/{autoId}
    // Cell events additionally expose columnId/cellKey, revision, and cellKeys
    // (1-4 distinct alphanumeric field keys; confirmations omit cellKeys).
    // cellCorrection events additionally require reasonCiphertext (24..8192
    // base64 chars), reasonIv (12 bytes base64), and correctedRevision (old revision).
    // lcgColumns stores revision/confirmation/editor metadata and cellAccessLevels,
    // a map (<=256 keys) from touched field keys to their latest editor access level.
    // Older columns may omit this map; migrate trusted history before rollout.
    // Clinical values remain client-encrypted; rules enforce envelope, membership and audit metadata.
    // Client-generated IDs are bounded; times are nonnegative epoch milliseconds.
    // Sign-offs reference new immutable events in the same atomic write.
    function privacyOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && uid.size() > 0 && uid.size() <= 128;
    }

    function currentPrivacyPolicyHash() {
      return '5eba1c4e9aef617b20d48dd452dc1f8bf203377f269e4f2e1cd9be11a9bd6b09';
    }

    function currentPrivacyPolicy(version, hash) {
      return version == '1.3' && hash == currentPrivacyPolicyHash();
    }

    function acceptedCurrentPrivacyPolicy(uid) {
      let receipt = get(/databases/$(database)/documents/users/$(uid)/privacy/current).data;
      // Ownership/schema are enforced on every receipt write. Keep this read check
      // compact because clinical multi-cell writes invoke authorization repeatedly.
      return receipt.decision == 'accepted' && receipt.policyVersion == '1.3'
        && receipt.policySha256 == '5eba1c4e9aef617b20d48dd452dc1f8bf203377f269e4f2e1cd9be11a9bd6b09';
    }

    function verifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true
        && acceptedCurrentPrivacyPolicy(request.auth.uid);
    }

    function validPrivacyEventId(eventId) {
      return eventId is string && eventId.matches('^[A-Za-z0-9]{20}$');
    }

    function validPrivacyEvent(data, uid) {
      return data.keys().hasAll(['schemaVersion', 'userId', 'email', 'emailVerified',
          'policyVersion', 'policySha256', 'decision', 'source', 'presentationVersion',
          'createdAt', 'clientOccurredAtMillis', 'language', 'userAgent'])
        && data.keys().hasOnly(['schemaVersion', 'userId', 'email', 'emailVerified',
          'policyVersion', 'policySha256', 'decision', 'source', 'presentationVersion',
          'createdAt', 'clientOccurredAtMillis', 'language', 'userAgent'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.userId is string && data.userId == uid && data.userId.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 320
        && data.email == request.auth.token.email
        && data.emailVerified is bool && data.emailVerified == request.auth.token.email_verified
        && currentPrivacyPolicy(data.policyVersion, data.policySha256)
        && data.decision in ['accepted', 'denied']
        && data.source in ['signup', 'account_gate', 'settings']
        && data.presentationVersion is int && data.presentationVersion == 2
        && data.createdAt is timestamp && data.createdAt == request.time
        && data.clientOccurredAtMillis is int && data.clientOccurredAtMillis >= 0
        && data.clientOccurredAtMillis <= 253402300799999
        && data.language is string && data.language.size() > 0 && data.language.size() <= 64
        && data.userAgent is string && data.userAgent.size() <= 512;
    }

    function validPrivacyReceipt(data, uid) {
      return data.keys().hasAll(['userId', 'lastEventId', 'decision', 'policyVersion', 'policySha256', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'lastEventId', 'decision', 'policyVersion', 'policySha256', 'updatedAt'])
        && data.userId is string && data.userId == uid && data.userId.size() <= 128
        && validPrivacyEventId(data.lastEventId)
        && data.decision in ['accepted', 'denied']
        && currentPrivacyPolicy(data.policyVersion, data.policySha256)
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function privacyEventMatchesReceipt(event, receipt, uid, eventId) {
      return validPrivacyEvent(event, uid) && validPrivacyReceipt(receipt, uid)
        && receipt.lastEventId == eventId && receipt.decision == event.decision
        && receipt.policyVersion == event.policyVersion && receipt.policySha256 == event.policySha256
        && receipt.updatedAt == event.createdAt;
    }

    function validNewPrivacyReceipt(data, uid) {
      return validPrivacyReceipt(data, uid)
        && !exists(/databases/$(database)/documents/users/$(uid)/privacyEvents/$(data.lastEventId))
        && privacyEventMatchesReceipt(
          getAfter(/databases/$(database)/documents/users/$(uid)/privacyEvents/$(data.lastEventId)).data,
          data, uid, data.lastEventId);
    }

    match /users/{uid}/privacyEvents/{eventId} {
      allow get: if privacyOwner(uid);
      allow list: if privacyOwner(uid) && request.query.limit != null && request.query.limit <= 100;
      allow create: if privacyOwner(uid) && validPrivacyEventId(eventId)
        && privacyEventMatchesReceipt(request.resource.data,
          getAfter(/databases/$(database)/documents/users/$(uid)/privacy/current).data, uid, eventId);
      allow update, delete: if false;
    }

    match /users/{uid}/privacy/{receiptId} {
      allow get: if receiptId == 'current' && privacyOwner(uid);
      allow list, delete: if false;
      allow create, update: if receiptId == 'current' && privacyOwner(uid)
        && validNewPrivacyReceipt(request.resource.data, uid);
    }

    function organizationExists(orgId) {
      return validOrganizationCode(orgId)
        && exists(/databases/$(database)/documents/organizations/$(orgId));
    }

    function validOrganizationCode(orgId) {
      return orgId.matches('^[A-Za-z0-9]{8}$');
    }

    // Authenticate before reading membership; the path UID is the authority for identity.
    function validActiveMembership(member, uid) {
      return member is map && member.userId == uid && member.status == 'active'
        && validRole(member.role) && validAccessLevel(member.accessLevel);
    }

    function activeMember(orgId) {
      return validOrganizationCode(orgId) && verifiedUser()
        && validActiveMembership(
          get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data,
          request.auth.uid);
    }

    function activeAdmin(orgId) {
      return activeMember(orgId)
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Maintenance is operational metadata only. Secrets remain encrypted in admin journals.
    function maintenanceActive(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/keyMaintenance/current)
        && get(/databases/$(database)/documents/organizations/$(orgId)/keyMaintenance/current).data.active;
    }
    function maintenanceAfter(orgId) {
      return existsAfter(/databases/$(database)/documents/organizations/$(orgId)/keyMaintenance/current)
        && getAfter(/databases/$(database)/documents/organizations/$(orgId)/keyMaintenance/current).data.active;
    }
    function writableClinicalMember(orgId) {
      return activeMember(orgId) && !maintenanceActive(orgId) && !maintenanceAfter(orgId);
    }
    function activeClinicalMember(orgId) {
      // All supported member roles (admin, doctor, nurse) participate in clinical care.
      return activeMember(orgId) && !maintenanceActive(orgId);
    }

    function canManageWomanArchive(orgId) {
      return writableClinicalMember(orgId)
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.accessLevel >= 60;
    }

    // getAfter permits approval and key delivery together, while rejecting absent/inactive recipients.
    function activeKeyRecipient(orgId, uid) {
      return uid is string && uid.size() > 0 && uid.size() <= 128
        && validActiveMembership(
          getAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(uid)).data, uid);
    }

    // An immutable roster link makes the archive lock enforceable without decrypting clinical data.
    function validClinicalRosterLink(orgId, data) {
      return data.womanDocumentId is string
        && data.womanDocumentId.matches('^[A-Za-z0-9_-]{1,128}$')
        && existsAfter(/databases/$(database)/documents/organizations/$(orgId)/women/$(data.womanDocumentId));
    }

    function writableClinicalColumn(orgId, data) {
      let woman = getAfter(/databases/$(database)/documents/organizations/$(orgId)/women/$(data.womanDocumentId)).data;
      return data.womanDocumentId is string && data.womanDocumentId.matches('^[A-Za-z0-9_-]{1,128}$')
        && woman is map && woman.get('archived', false) == false;
    }

    // Synthetic demo envelope: ciphertext-only; no patient data or key material.
    function validSyntheticObservation(data) {
      return data.keys().hasOnly([
          'ciphertext', 'iv', 'keyVersion', 'algorithm', 'schemaVersion', 'createdBy', 'createdAt'
        ])
        && data.keys().hasAll([
          'ciphertext', 'iv', 'keyVersion', 'algorithm', 'schemaVersion', 'createdBy', 'createdAt'
        ])
        && data.ciphertext is string
        && data.ciphertext.size() > 0
        && data.ciphertext.size() <= 4096
        && data.iv is string
        && data.iv.matches('^[A-Za-z0-9+/]{16}$')
        && data.keyVersion == 1
        && data.algorithm == 'AES-GCM'
        && data.schemaVersion == 1
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.createdBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function validRole(role) {
      return role in ['admin', 'doctor', 'nurse'];
    }

    function validAccessLevel(level) {
      return level is int && level >= 10 && level <= 99;
    }

    function validMember(data) {
      return data.keys().hasOnly(['userId', 'name', 'role', 'status', 'accessLevel', 'joinedAt'])
        && data.keys().hasAll(['userId', 'name', 'role', 'status', 'accessLevel', 'joinedAt'])
        && data.userId is string
        && data.userId.size() > 0 && data.userId.size() <= 128
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 160
        && validRole(data.role)
        && data.status == 'active'
        && validAccessLevel(data.accessLevel)
        && data.joinedAt is timestamp;
    }

    // Allows an admin to update a legacy member document that may not yet have a name,
    // while validating the entire resulting document and preserving all non-level fields.
    function validMemberAfterAccessLevelUpdate(data) {
      return data.keys().hasOnly(['userId', 'name', 'role', 'status', 'accessLevel', 'joinedAt'])
        && data.keys().hasAll(['userId', 'role', 'status', 'accessLevel', 'joinedAt'])
        && data.userId is string
        && data.userId.size() > 0 && data.userId.size() <= 128
        && (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 160))
        && validRole(data.role)
        && data.status == 'active'
        && validAccessLevel(data.accessLevel)
        && data.joinedAt is timestamp;
    }

    function validMemberAfterStatusUpdate(data) {
      return data.keys().hasOnly(['userId', 'name', 'role', 'status', 'accessLevel', 'joinedAt'])
        && data.keys().hasAll(['userId', 'role', 'status', 'accessLevel', 'joinedAt'])
        && data.userId is string
        && data.userId.size() > 0 && data.userId.size() <= 128
        && (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 160))
        && data.role in ['doctor', 'nurse']
        && data.status in ['active', 'inactive']
        && validAccessLevel(data.accessLevel)
        && data.joinedAt is timestamp;
    }

    function validAccessRequest(data) {
      return data.keys().hasOnly([
          'userId', 'userName', 'userEmail', 'requestedRole', 'status', 'createdAt',
          'reviewedBy', 'reviewedAt', 'approvedRole', 'cancelledAt'
        ])
        && data.keys().hasAll(['userId', 'userName', 'requestedRole', 'status', 'createdAt'])
        && data.userId is string
        && data.userId.size() > 0 && data.userId.size() <= 128
        && data.userName is string
        && data.userName.size() > 0
        && data.userName.size() <= 160
        && (!('userEmail' in data)
          || (data.userEmail is string
            && data.userEmail.size() > 0
            && data.userEmail.size() <= 254))
        && data.requestedRole in ['doctor', 'nurse']
        && data.status in ['pending', 'approved', 'rejected', 'cancelled']
        && data.createdAt is timestamp
        && ((data.status == 'pending' && !('cancelledAt' in data)
              && !('reviewedBy' in data)
              && !('reviewedAt' in data)
              && !('approvedRole' in data))
          || (data.status == 'cancelled' && data.cancelledAt is timestamp
              && !('reviewedBy' in data) && !('reviewedAt' in data) && !('approvedRole' in data))
          || (data.status in ['approved', 'rejected'] && !('cancelledAt' in data)
              && data.reviewedBy is string
              && data.reviewedBy.size() > 0 && data.reviewedBy.size() <= 128
              && data.reviewedAt is timestamp
              && (!('approvedRole' in data) || validRole(data.approvedRole))));
    }

    function validMemberAfterLeave(data) {
      return data.keys().hasOnly(['userId', 'name', 'role', 'status', 'accessLevel', 'joinedAt', 'leftAt', 'leftDuringRotationId'])
        && data.keys().hasAll(['userId', 'role', 'status', 'accessLevel', 'joinedAt', 'leftAt', 'leftDuringRotationId'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 160))
        && data.role in ['doctor', 'nurse'] && validAccessLevel(data.accessLevel) && data.joinedAt is timestamp
        && data.status == 'left' && data.leftAt == request.time
        && data.leftDuringRotationId is string && data.leftDuringRotationId.matches('^[A-Za-z0-9_-]{22}$');
    }

    function validMemberPublicKeyProfile(data, uid) {
      return data.keys().hasOnly([
          'userId', 'publicKeyJwk', 'publicKeyFingerprint', 'keyAlgorithm', 'createdAt'
        ])
        && data.keys().hasAll([
          'userId', 'publicKeyJwk', 'publicKeyFingerprint', 'keyAlgorithm', 'createdAt'
        ])
        && data.userId == uid
        && data.publicKeyJwk is string
        && data.publicKeyJwk.size() > 0
        && data.publicKeyJwk.size() <= 4096
        && data.publicKeyFingerprint is string
        && data.publicKeyFingerprint.matches('^[A-Za-z0-9_-]{32,64}$')
        && data.keyAlgorithm == 'RSA-OAEP-3072-SHA256'
        && data.createdAt is timestamp;
    }

    function validPrivateKeyBackup(data, uid) {
      return data.keys().hasOnly([
          'userId', 'ciphertext', 'iv', 'salt', 'kdf', 'kdfIterations', 'keyAlgorithm', 'updatedAt'
        ])
        && data.keys().hasAll([
          'userId', 'ciphertext', 'iv', 'salt', 'kdf', 'kdfIterations', 'keyAlgorithm', 'updatedAt'
        ])
        && data.userId == uid
        && data.ciphertext is string
        && data.ciphertext.size() > 0
        && data.ciphertext.size() <= 16384
        && data.ciphertext.matches('^[A-Za-z0-9+/]+={0,2}$')
        && data.iv is string
        && data.iv.matches('^[A-Za-z0-9+/]{16}$')
        && data.salt is string
        && data.salt.matches('^[A-Za-z0-9+/]{22}==$')
        && data.kdf == 'PBKDF2-SHA256'
        && data.kdfIterations == 600000
        && data.keyAlgorithm == 'RSA-OAEP-3072-SHA256'
        && data.updatedAt is timestamp;
    }

    // Rotation history: keyHistory/{oldVersion} contains the previous DEK encrypted by its successor.
    // lcgCells/{columnId}~{cellKey}: bounded current-event projection; sourceEventId + immutable event map.
    function currentDataKey(orgId, version) {
      return !maintenanceActive(orgId) && !maintenanceAfter(orgId)
        && version is int && version >= 1 && version <= 1000000
        && version == get(/databases/$(database)/documents/organizations/$(orgId)/keyMetadata/current).data.currentKeyVersion;
    }

    function validKeyMetadata(data) {
      return data.keys().hasOnly(['currentKeyVersion', 'algorithm', 'updatedAt', 'updatedBy', 'rotationId'])
        && data.keys().hasAll(['currentKeyVersion', 'algorithm', 'updatedAt', 'updatedBy'])
        && data.currentKeyVersion is int
        && data.currentKeyVersion >= 1
        && data.currentKeyVersion <= 1000000
        && (!('rotationId' in data) || (data.rotationId is string && data.rotationId.matches('^[A-Za-z0-9_-]{22}$')))
        && data.algorithm == 'AES-256-GCM'
        && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid;
    }

    function validKeyEnvelope(data, uid) {
      return data.keys().hasOnly([
          'userId', 'keyVersion', 'wrappedKey', 'algorithm', 'grantedBy', 'createdAt'
        ])
        && data.keys().hasAll([
          'userId', 'keyVersion', 'wrappedKey', 'algorithm', 'grantedBy', 'createdAt'
        ])
        && data.userId == uid
        && data.keyVersion is int
        && data.keyVersion >= 1
        && data.keyVersion <= 1000000
        && data.wrappedKey is string
        && data.wrappedKey.size() > 0
        && data.wrappedKey.size() <= 2048
        && data.wrappedKey.matches('^[A-Za-z0-9+/]+={0,2}$')
        && data.algorithm == 'RSA-OAEP-3072-SHA256'
        && data.grantedBy == request.auth.uid
        && data.createdAt is timestamp;
    }

    function clinicalKeyMember(orgId, uid) {
      let member = get(/databases/$(database)/documents/organizations/$(orgId)/members/$(uid)).data;
      return verifiedUser() && member.userId == uid && member.status == 'active' && member.role in ['doctor', 'nurse'];
    }

    function validKeyReplacement(data, uid) {
      return data.keys().hasOnly(['userId', 'requestId', 'previousFingerprint', 'profile', 'backup', 'createdAt', 'status', 'resolvedBy', 'resolvedAt'])
        && data.keys().hasAll(['userId', 'requestId', 'previousFingerprint', 'profile', 'backup', 'createdAt', 'status'])
        && data.userId == uid && uid.size() > 0 && uid.size() <= 128
        && data.requestId is string && data.requestId.matches('^[A-Za-z0-9_-]{22}$')
        && data.previousFingerprint is string && data.previousFingerprint.matches('^[A-Za-z0-9_-]{32,64}$')
        && data.profile is map && validMemberPublicKeyProfile(data.profile, uid)
        && data.backup is map && validPrivateKeyBackup(data.backup, uid)
        && data.profile.publicKeyFingerprint != data.previousFingerprint
        && data.createdAt is timestamp && data.profile.createdAt == data.createdAt && data.backup.updatedAt == data.createdAt
        && ((data.status == 'pending' && !data.keys().hasAny(['resolvedBy', 'resolvedAt']))
          || (data.status in ['approved', 'rejected', 'cancelled'] && data.keys().hasAll(['resolvedBy', 'resolvedAt'])
            && data.resolvedBy is string && data.resolvedBy.size() > 0 && data.resolvedBy.size() <= 128
            && data.resolvedAt is timestamp));
    }

    function replacementAdmin(orgId, uid) {
      return activeAdmin(orgId) && request.auth.uid != uid && clinicalKeyMember(orgId, uid)
        && !maintenanceActive(orgId) && !maintenanceAfter(orgId);
    }

    // Used only by companion writes; the request rule enforces all companions in the same commit.
    function approvingKeyReplacement(orgId, uid) {
      let before = get(/databases/$(database)/documents/organizations/$(orgId)/keyReplacementRequests/$(uid)).data;
      let after = getAfter(/databases/$(database)/documents/organizations/$(orgId)/keyReplacementRequests/$(uid)).data;
      return replacementAdmin(orgId, uid) && before.status == 'pending' && after.status == 'approved'
        && after.requestId == before.requestId && after.resolvedBy == request.auth.uid && after.resolvedAt == request.time;
    }

    match /organizations/{orgId} {
      // Root metadata: name (required), organizationName, createdAt, status (optional).
      // Active members may read this metadata; listing and client writes stay denied.
      // Reject unexpected fields so private data cannot be exposed by this read rule.
      allow get: if activeMember(orgId)
        && resource.data.keys().hasOnly(['name', 'organizationName', 'createdAt', 'status'])
        && resource.data.name is string
        && resource.data.name.size() > 0
        && resource.data.name.size() <= 160
        && (!('organizationName' in resource.data) ||
          (resource.data.organizationName is string && resource.data.organizationName.size() > 0
            && resource.data.organizationName.size() <= 160))
        && (!('createdAt' in resource.data) || resource.data.createdAt is timestamp)
        && (!('status' in resource.data) ||
          (resource.data.status is string && resource.data.status.size() > 0
            && resource.data.status.size() <= 32));
      allow list, create, update, delete: if false;

      match /members/{memberId} {
        allow get: if validOrganizationCode(orgId)
          && verifiedUser()
          && (request.auth.uid == memberId || activeAdmin(orgId));
        allow list: if validOrganizationCode(orgId) && activeAdmin(orgId);

        // Approval must be an atomic batch that also marks the request approved.
        allow create: if activeAdmin(orgId) && !maintenanceActive(orgId) && !maintenanceAfter(orgId)
          && memberId != request.auth.uid
          && validMember(request.resource.data)
          && request.resource.data.userId == memberId
          && request.resource.data.joinedAt == request.time
          && exists(/databases/$(database)/documents/organizations/$(orgId)/keyProfiles/$(memberId))
          && exists(/databases/$(database)/documents/organizations/$(orgId)/keyBackups/$(memberId))
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/accessRequests/$(memberId)).data.status == 'approved'
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/accessRequests/$(memberId)).data.reviewedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/accessRequests/$(memberId)).data.userName == request.resource.data.name
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/accessRequests/$(memberId)).data.approvedRole == request.resource.data.role;
        // Rejoin is a distinct narrow transition, evaluated before the general member update rules.
        allow update: if activeAdmin(orgId) && !maintenanceActive(orgId) && !maintenanceAfter(orgId)
          && memberId == resource.data.userId && resource.data.status == 'left'
          && validMember(request.resource.data)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.joinedAt == request.time
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/accessRequests/$(memberId)).data.status == 'approved'
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/accessRequests/$(memberId)).data.reviewedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/accessRequests/$(memberId)).data.userName == request.resource.data.name
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/accessRequests/$(memberId)).data.approvedRole == request.resource.data.role
          && exists(/databases/$(database)/documents/organizations/$(orgId)/keyProfiles/$(memberId))
          && exists(/databases/$(database)/documents/organizations/$(orgId)/keyBackups/$(memberId));
        // Only organization admins may change accessLevel; role, name, identity, and timestamps stay fixed.
        allow update: if activeAdmin(orgId) && !maintenanceActive(orgId) && !maintenanceAfter(orgId)
          && memberId == resource.data.userId
          && validMemberAfterAccessLevelUpdate(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessLevel'])
          && request.resource.data.userId == resource.data.userId
          && (!('name' in resource.data) || request.resource.data.name == resource.data.name)
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.joinedAt == resource.data.joinedAt;
        // Role-only swaps retain identity, authorship, status, access level, and encryption grants.
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role != resource.data.role
          && activeAdmin(orgId) && !maintenanceActive(orgId) && !maintenanceAfter(orgId)
          && memberId != request.auth.uid && memberId == resource.data.userId
          && resource.data.role in ['doctor', 'nurse'] && resource.data.status in ['active', 'inactive']
          && validMemberAfterStatusUpdate(request.resource.data);
        // Admins can deactivate/reactivate clinical members, but cannot change admin memberships here.
        allow update: if activeAdmin(orgId)
          && memberId == resource.data.userId
          && resource.data.role in ['doctor', 'nurse']
          && resource.data.status in ['active', 'inactive']
          && validMemberAfterStatusUpdate(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
