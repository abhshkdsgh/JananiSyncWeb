          && request.resource.data.phase == 'preparing' && request.resource.data.nextIndex == 0
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/organizations/$(orgId)/keyMetadata/current).data.currentKeyVersion == request.resource.data.baseVersion
          && (request.resource.data.removedUserId == '' ||
            (get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.resource.data.removedUserId)).data.status == 'active'
              && getAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.resource.data.removedUserId)).data.status == 'inactive'));
        allow update: if activeAdmin(orgId) && validRotation(request.resource.data) && boundMaintenance()
          && maintenanceActive(orgId) && resource.data.adminId == request.auth.uid
          && get(/databases/$(database)/documents/organizations/$(orgId)/keyMaintenance/current).data.rotationId == rotationId
          && request.resource.data.adminId == resource.data.adminId
          && request.resource.data.removedUserId == resource.data.removedUserId
          && request.resource.data.baseVersion == resource.data.baseVersion
          && request.resource.data.targetVersion == resource.data.targetVersion
