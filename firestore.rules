            && (!maintenanceActive(orgId) || get(/databases/$(database)/documents/organizations/$(orgId)/keyMaintenance/current).data.get('awaitingAdmin', false))
            && maintenanceAfter(orgId)
            && getAfter(/databases/$(database)/documents/organizations/$(orgId)/keyMaintenance/current).data.get('awaitingAdmin', false)
