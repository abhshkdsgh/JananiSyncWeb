            && data.keys().hasAll(['active', 'awaitingAdmin', 'departedUserId', 'rotationId', 'adminId', 'completed', 'total', 'updatedAt'])
            && data.active == true && data.awaitingAdmin == true && data.departedUserId == request.auth.uid
